# Variables de entorno para conexión a Supabase (Marin Industries)
# Copia este contenido a un archivo nuevo llamado ".env.local" en esta misma carpeta:

# Opción A (Recomendada para Next.js con prefijo público):
NEXT_PUBLIC_SUPABASE_URL=https://qfqhkwwtwbmggfgwavpn.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu_sb_publishable_key_aqui

# Opción B (Si copiaste directo con el botón "Copy all" de Supabase):
SUPABASE_URL=https://qfqhkwwtwbmggfgwavpn.supabase.co
SUPABASE_PUBLISHABLE_KEY=tu_sb_publishable_key_aqui
SUPABASE_SECRET_KEY=tu_sb_secret_key_aqui
