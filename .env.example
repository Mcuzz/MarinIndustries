# Variables de entorno para conexión a Supabase (Marin Industries)
# Copia este contenido a un archivo nuevo llamado ".env.local" en esta misma carpeta:

# Opción A (Recomendada para Next.js con prefijo público):
NEXT_PUBLIC_SUPABASE_URL=https://vmwbpzokqvvysmuiyqwb.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu_sb_publishable_key_aqui

# Opción B (Si copiaste directo con el botón "Copy all" de Supabase):
SUPABASE_URL=https://vmwbpzokqvvysmuiyqwb.supabase.co
SUPABASE_PUBLISHABLE_KEY=tu_sb_publishable_key_aqui
SUPABASE_SECRET_KEY=tu_sb_secret_key_aqui

# ---------------------------------------------------------------
# Mercado Pago (Checkout Pro)
# Panel: https://www.mercadopago.com.mx/developers → Tus integraciones → [app] → Credenciales
# Usa SIEMPRE las credenciales de PRUEBA mientras el proyecto esté en desarrollo.
# Las de producción las debe generar y configurar el dueño de la cuenta del cliente.
# ---------------------------------------------------------------

# Public Key: se puede exponer en el navegador.
NEXT_PUBLIC_MERCADOPAGO_PUBLIC_KEY=tu_public_key_aqui

# Access Token: SECRETO. Solo se usa en el servidor. Nunca le pongas el prefijo NEXT_PUBLIC_.
MERCADOPAGO_ACCESS_TOKEN=tu_access_token_aqui

# URL del sitio, para las páginas de regreso de Mercado Pago (back_urls).
# En local déjala en http://localhost:3000 aunque uses ngrok: la URL de ngrok solo se pone
# en el panel de Mercado Pago (Webhooks). En producción: la URL https del sitio.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Clave secreta del webhook (Tus integraciones → [app] → Webhooks → Configurar notificaciones → "Clave secreta").
# SECRETA: solo servidor. Sirve para verificar que los avisos realmente vienen de Mercado Pago.
MERCADOPAGO_WEBHOOK_SECRET=tu_clave_secreta_del_webhook
